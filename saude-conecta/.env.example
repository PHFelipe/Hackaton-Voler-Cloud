# ---- Modelo de linguagem (com tool calling) ----
# Provedor: groq (padrão) ou anthropic
LLM_PROVIDER=groq
# Chave da Groq (crie em https://console.groq.com/keys). O iniciar pede e salva aqui.
GROQ_API_KEY=sua-chave-aqui
# Só se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opcional. Padrão na Groq: openai/gpt-oss-120b (alternativa: llama-3.3-70b-versatile).
# Padrão no Claude: claude-opus-5-5
LLM_MODEL=
# Opcional. low | medium | high. Padrão: medium
LLM_EFFORT=medium

# ---- Servidor MCP Brasil (Streamable HTTP) ----
# O projeto MCP Brasil NÃO publica um endpoint HTTPS público. O run.py sobe um servidor local.
#  a) servidor local (padrão):                       http://localhost:8000/mcp
#  b) sua própria implantação HTTPS do MCP Brasil:   https://seu-dominio/mcp
MCP_SERVER_URL=http://localhost:8000/mcp
# Opcional. Token Bearer, se a sua implantação HTTPS exigir autenticação
MCP_AUTH_TOKEN=
# Opcional. Timeout das chamadas ao MCP, em segundos
MCP_TIMEOUT=60
